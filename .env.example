# --- Data provider ---
POLYGON_API_KEY=your_polygon_key_here

# --- Alpaca (free historical trades/quotes -> real order flow in backtests) ---
# Polygon's free tier has no tick history, so CVD is currently synthesised from
# bar shape. Alpaca serves real prints on the free plan. Run
# `python main.py alpaca-check` after filling these in to see which feed the key
# is entitled to (iex = ~2.5% of volume, sip = full consolidated tape).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=iex

# --- Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Account / risk ---
ACCOUNT_EQUITY=10000
RISK_PER_TRADE_PCT=0.5
DAILY_KILL_SWITCH_PCT=2.0
PDT_ACCOUNT=true
